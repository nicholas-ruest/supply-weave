    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@eslint/js": "9.39.1",
    "typescript-eslint": "8.46.2",
    "eslint": "9.39.1",
    "globals": "15.14.0",
    "vitest": "4.1.12",
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.5"
